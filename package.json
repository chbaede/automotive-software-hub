{
  "name": "automotive-software-hub",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsx scripts/generate-sitemap.ts && tsc && vite build && tsx scripts/postbuild.ts",
    "validate-data": "tsx scripts/validate-data.ts",
    "test": "tsx tests/graph.test.ts",
    "typecheck": "tsc --noEmit",
